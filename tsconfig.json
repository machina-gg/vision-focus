{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // .wxt/tsconfig.json は WXT が `wxt prepare` で生成する（postinstall で走る）。
    // パスエイリアス（~ / @）と拡張機能用の型参照はそちらが持つ。
    "jsx": "preserve",
    "types": ["vitest/globals", "chrome"]
  },
  "exclude": ["**/node_modules", ".output", "build", "storybook-static"]
}
